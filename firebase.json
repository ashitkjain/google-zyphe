{
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-*.log"
            ]
        }
    ],
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "hosting": {
        "public": "dist",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/api/webhooks/zillow",
                "function": "zillowWebhook"
            },
            {
                "source": "/api/webhooks/realtor",
                "function": "realtorWebhook"
            },
            {
                "source": "/api/webhooks/facebook",
                "function": "facebookWebhook"
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}