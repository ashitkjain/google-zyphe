{
  "name": "zyphe-vision-analyzer",
  "version": "1.0.0",
  "description": "Chrome extension for AI property photo analysis using Llama 3.2 Vision via WebLLM",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "clean": "rm -rf dist",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=pageExtractors",
    "test:phase1": "node tests/phase1-classify.test.mjs",
    "bench:phase1": "node tests/phase1-bench-speed.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.83"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.97.0",
    "webpack-cli": "^5.1.4"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {},
    "setupFiles": ["./src/jest.setup.js"]
  },
  "type": "module"
}
