rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ═══════════════════════════════════════════════════════
    // 1. PUBLIC READ, AUTHENTICATED WRITE (Property Intelligence / Global)
    // ═══════════════════════════════════════════════════════
    match /{collectionName}/{zpid} {
      allow read: if collectionName in [
        'properties', 
        'property_analyses_visual', 
        'property_analyses_comprehensive', 
        'image_quality_analysis', 
        'property_assets',
        'property_investment_research',
        'general_market_intelligence',
        'community_pulse',
        'deep_investment_research',
        'google_environmental_data',
        'ai_assessment',
        'context_graph',
        'sold_or_unlisted_properties',
        'distress_analysis',
        'zip_sold_listings_cache',
        'deprecated_distressed_properties',
        'lifestyle_insights',
        'address_index',
        'cities',
        'schools_intelligence',
        'orientation_versions',
        'orientation_ground_truth'
      ];
      allow write: if request.auth != null && collectionName in [
        'properties', 
        'property_analyses_visual', 
        'property_analyses_comprehensive', 
        'image_quality_analysis', 
        'property_assets',
        'property_investment_research',
        'general_market_intelligence',
        'community_pulse',
        'deep_investment_research',
        'google_environmental_data',
        'ai_assessment',
        'context_graph',
        'sold_or_unlisted_properties',
        'distress_analysis',
        'zip_sold_listings_cache',
        'deprecated_distressed_properties',
        'lifestyle_insights',
        'address_index',
        'cities',
        'schools_intelligence',
        'orientation_versions',
        'orientation_ground_truth'
      ];
    }

    // ═══════════════════════════════════════════════════════
    // 1a. Nested Analysis Subcollections under properties
    //     e.g. properties/{zpid}/analysis/{docType}
    // ═══════════════════════════════════════════════════════
    match /properties/{zpid}/{subPath=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /orientation_versions/{city}/{subPath=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ═══════════════════════════════════════════════════════
    // 1b. Unified City Intelligence (Nested)
    // ═══════════════════════════════════════════════════════
    match /cities/{cityId} {
      allow read: if true;
      allow write: if request.auth != null;
      
      match /{subPath=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Collection group query support — required for collectionGroup("neighborhoods") queries.
    // Firestore requires an explicit wildcard path rule; the cities/{cityId}/{subPath=**} rule alone is insufficient.
    match /{path=**}/neighborhoods/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{path=**}/history/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{path=**}/analysis/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /system_test/{docId} {
      allow read, write: if true; 
    }

    // ═══════════════════════════════════════════════════════
    // 2. USER DATA & USER SUBCOLLECTIONS
    // ═══════════════════════════════════════════════════════
    match /users/{userId} {
      // Users can manage their own profiles
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Realtors can read profiles of clients they invited
      allow read, delete: if request.auth != null && 
                   resource.data.realtorId == request.auth.uid;
      
      match /viewHistory/{zpid} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && 
                     get(/databases/$(database)/documents/users/$(userId)).data.realtorId == request.auth.uid;
      }
      
      match /favorites/{zpid} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && 
                     get(/databases/$(database)/documents/users/$(userId)).data.realtorId == request.auth.uid;
      }

      // NEW: User preferences subcollection (commute destination, etc.)
      match /preferences/{prefId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // NEW: User property comments (sticky notes) — owner only
      match /property_comments/{commentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Legacy: user_preferences (kept for rollback)
    match /user_preferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ═══════════════════════════════════════════════════════
    // 3. REALTOR TENANT DATA — /realtors/{realtorId}/...
    //    Access: Only the realtor who owns the tenant OR
    //    clients assigned to that realtor (for read-only views)
    // ═══════════════════════════════════════════════════════
    
    // Helper: Is the authenticated user the owner of this realtor tenant?
    function isRealtorOwner(realtorId) {
      return request.auth != null && request.auth.uid == realtorId;
    }

    // Helper: Is the authenticated user a client of this realtor?
    function isClientOfRealtor(realtorId) {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.realtorId == realtorId;
    }

    // Helper: Is the authenticated user an admin?
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /realtors/{realtorId} {
      // Allow realtor to read/write their own tenant root doc (if it exists)
      allow read, write: if isRealtorOwner(realtorId);

      // --- CRM Data ---
      match /leads/{leadId} {
        allow read, write: if isRealtorOwner(realtorId);
      }
      match /buyers/{docId} {
        allow read, write: if isRealtorOwner(realtorId);
      }
      match /sellers/{docId} {
        allow read, write: if isRealtorOwner(realtorId);
      }
      match /tasks/{taskId} {
        allow read, write: if isRealtorOwner(realtorId);
      }
      match /templates/{templateId} {
        allow read, write: if isRealtorOwner(realtorId);
      }
      match /notes/{noteId} {
        allow read, write: if isRealtorOwner(realtorId);
      }

      // --- Calendar ---
      match /calendar_events/{eventId} {
        allow read, write: if isRealtorOwner(realtorId);
        // Clients can read their own calendar events
        allow read: if isClientOfRealtor(realtorId);
      }

      // --- Reminder Rules ---
      match /reminderRules/{ruleId} {
        allow read, write: if isRealtorOwner(realtorId);
      }

      // --- Transactions ---
      match /transactions/{transactionId} {
        allow read, write: if isRealtorOwner(realtorId);
        // Clients can read their transactions
        allow read: if isClientOfRealtor(realtorId);
      }

      // --- Transaction Parties ---
      match /transaction_parties/{partyId} {
        allow read, write: if isRealtorOwner(realtorId);
      }

      // --- Transaction Documents + Versions ---
      match /transaction_documents/{documentId} {
        allow read, write: if isRealtorOwner(realtorId);
        match /versions/{versionId} {
          allow read, write: if isRealtorOwner(realtorId);
        }
      }

      // --- Audit Events (append-only for realtor) ---
      match /audit_events/{auditId} {
        allow read, create: if isRealtorOwner(realtorId);
        allow update, delete: if false;
      }

      // --- Messages (Reactivation SMS) ---
      match /messages/{messageId} {
        allow read, write: if isRealtorOwner(realtorId);
      }

      // --- Message Events ---
      match /message_events/{eventId} {
        allow read, write: if isRealtorOwner(realtorId);
      }

      // --- Journey Events ---
      match /journey_events/{eventId} {
        allow read, write: if isRealtorOwner(realtorId);
      }

      // --- Whiteboards ---
      match /whiteboards/{boardId} {
        allow read, write: if isRealtorOwner(realtorId);
      }

      // --- Leads Documents ---
      match /leads_documents/{documentId} {
        allow read, write: if isRealtorOwner(realtorId);
      }

      // --- Reactivation Analysis ---
      match /reactivation_analysis_summary/{summaryId} {
        allow read, write: if isRealtorOwner(realtorId);
      }
      match /market_context/{contextId} {
        allow read, write: if isRealtorOwner(realtorId);
      }
      match /lead_plans/{planId} {
        allow read, write: if isRealtorOwner(realtorId);
      }

      // --- Clients subcollection (realtor's view of their clients) ---
      match /clients/{clientId} {
        allow read, write: if isRealtorOwner(realtorId);
        // Client can read their own entry
        allow read: if request.auth != null && request.auth.uid == clientId;
      }
    }

    // ═══════════════════════════════════════════════════════
    // 4. LEGACY FLAT COLLECTIONS (kept for rollback — remove after migration verified)
    // ═══════════════════════════════════════════════════════
    match /leads/{leadId} {
      allow read, write: if request.auth != null && 
                           (resource.data.realtorId == request.auth.uid || 
                            request.resource.data.realtorId == request.auth.uid);
    }

    match /tasks/{taskId} {
      allow read: if request.auth != null && resource.data.realtorId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.realtorId == request.auth.uid;
      allow update: if request.auth != null && resource.data.realtorId == request.auth.uid && request.resource.data.realtorId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.realtorId == request.auth.uid;
    }

    match /templates/{templateId} {
      allow read, write: if request.auth != null && 
                           (resource.data.realtorId == request.auth.uid || 
                            request.resource.data.realtorId == request.auth.uid);
    }

    match /notes/{noteId} {
      allow read, write: if request.auth != null && 
                           (resource.data.realtorId == request.auth.uid || 
                            request.resource.data.realtorId == request.auth.uid);
    }

    match /reminderRules/{ruleId} {
      allow read: if request.auth != null && resource.data.realtorId == request.auth.uid;
      allow write: if request.auth != null && 
                    ( (resource == null && request.resource.data.realtorId == request.auth.uid) || 
                      (resource != null && resource.data.realtorId == request.auth.uid) );
    }

    match /calendar_events/{eventId} {
      allow read, write: if request.auth != null && 
                           (resource.data.realtorId == request.auth.uid || 
                            request.resource.data.realtorId == request.auth.uid);
    }

    match /messages/{messageId} {
      allow read, list: if request.auth != null && (
          resource.data.senderId == request.auth.uid ||
          resource.data.receiverId == request.auth.uid
      );
      allow create: if request.auth != null && (
          request.resource.data.senderId == request.auth.uid ||
          request.resource.data.receiverId == request.auth.uid
      );
      allow update: if request.auth != null && (
          resource.data.senderId == request.auth.uid ||
          resource.data.receiverId == request.auth.uid
      );
      allow delete: if request.auth != null && (
          resource.data.senderId == request.auth.uid ||
          resource.data.receiverId == request.auth.uid
      );
    }

    // Internal team messaging (unchanged — not tenant-scoped)
    match /internal_messages/{messageId} {
      allow read: if request.auth != null && (
          request.auth.uid in resource.data.participants ||
          resource.data.senderId == request.auth.uid
      );
      allow create: if request.auth != null &&
          request.auth.uid in request.resource.data.participants;
      allow delete: if request.auth != null && (
          request.auth.uid in resource.data.participants ||
          resource.data.senderId == request.auth.uid
      );
    }

    match /mail/{mailId} {
      allow create: if request.auth != null;
    }

    match /whiteboards/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /journey_events/{eventId} {
      allow read, write: if request.auth != null;
    }

    // Legacy transactions (kept for rollback)
    function isTransactionOwner(transactionId) {
      let data = get(/databases/$(database)/documents/transactions/$(transactionId)).data;
      return (data.get('realtorId', '') == request.auth.uid || data.get('owner_user_id', '') == request.auth.uid);
    }

    match /transactions/{transactionId} {
      allow read: if request.auth != null && 
                    (resource.data.get('realtorId', '') == request.auth.uid || 
                     resource.data.get('owner_user_id', '') == request.auth.uid);
      
      allow write: if request.auth != null && 
                     ( (resource == null && request.resource.data.get('realtorId', '') == request.auth.uid) || 
                       (resource != null && (resource.data.get('realtorId', '') == request.auth.uid || 
                                             resource.data.get('owner_user_id', '') == request.auth.uid)) );
                                             
      match /parties/{partyId} {
         allow read, write: if request.auth != null;
      }
    }

    match /transaction_parties/{partyId} {
      allow read, write: if request.auth != null;
    }

    match /transaction_documents/{documentId} {
      allow read, write: if request.auth != null;
      match /versions/{versionId} {
        allow read, write: if request.auth != null;
      }
    }

    match /documents/{documentId} {
      allow read, write: if request.auth != null; 
    }

    match /document_versions/{versionId} {
      allow read, write: if request.auth != null && 
                           isTransactionOwner(get(/databases/$(database)/documents/documents/$(resource.data.document_id || request.resource.data.document_id)).data.transaction_id);
    }

    match /signature_envelopes/{envelopeId} {
      allow read, write: if request.auth != null && 
                           isTransactionOwner(resource.data.get('transaction_id', '') || request.resource.data.get('transaction_id', ''));
    }

    match /signature_events/{eventId} {
      allow read, write: if request.auth != null && 
                           isTransactionOwner(get(/databases/$(database)/documents/signature_envelopes/$(resource.data.signature_envelope_id || request.resource.data.signature_envelope_id)).data.transaction_id);
    }

    match /message_events/{eventId} {
      allow read, write: if request.auth != null && 
                           ( (resource == null && request.resource.data.agent_id == request.auth.uid) || 
                             (resource != null && resource.data.agent_id == request.auth.uid) );
    }

    match /audit_events/{auditId} {
      allow read: if request.auth != null &&
                    resource.data.transaction_id is string &&
                    isTransactionOwner(resource.data.transaction_id);
      allow write: if request.auth != null &&
                     request.resource.data.transaction_id is string &&
                     isTransactionOwner(request.resource.data.transaction_id);
      allow update, delete: if false;
    }

    match /leads_documents/{documentId} {
      allow read, write: if request.auth != null;
    }

    match /llm_call_events/{eventId} {
      allow create: if (request.auth != null && request.resource.data.user_id == request.auth.uid) || 
                       (request.resource.data.user_id == 'unknown');
      allow read, update: if (request.auth != null && resource.data.user_id == request.auth.uid) ||
                             (resource.data.user_id == 'unknown') || isAdmin();
      allow delete: if false;
    }

    match /api_call_events/{eventId} {
      allow create: if (request.auth != null && request.resource.data.user_id == request.auth.uid) || 
                       (request.resource.data.user_id == 'unknown');
      allow read, update: if (request.auth != null && resource.data.user_id == request.auth.uid) ||
                             (resource.data.user_id == 'unknown') || isAdmin();
      allow delete: if false;
    }

    match /reactivation_analysis_summary/{summaryId} {
      allow read, write: if request.auth != null && 
                           ( (resource == null && request.resource.data.userId == request.auth.uid) || 
                             (resource != null && resource.data.userId == request.auth.uid) );
    }

    match /market_context/{contextId} {
      allow read, write: if request.auth != null && 
                           ( (resource == null && request.resource.data.userId == request.auth.uid) || 
                             (resource != null && resource.data.userId == request.auth.uid) );
    }

    match /lead_plans/{planId} {
      allow read, write: if request.auth != null && 
                           ( (resource == null && request.resource.data.userId == request.auth.uid) || 
                             (resource != null && resource.data.userId == request.auth.uid) );
    }

    match /guides/{guideId} {
      allow read, write: if true;
    }

    match /best_practices/{docId} {
      allow read, write: if request.auth != null;
    }

    // 7. CITY DATA CACHE (Realtor Tools)
    match /city_zip_cache/{cityName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /city_noise_cache/{citySlug} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /zip_listings_cache/{zipCode} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /rentcast_comps/{compId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /zyphe_valuations/{valuationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Legacy user_property_comment (kept for rollback)
    match /user_property_comment/{commentId} {
      allow read, write: if request.auth != null && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // 8. PIPELINE AUDIT TRAIL
    match /pipeline_audit_trail/{entryId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
    // 9. APP CONFIG (API keys loaded at runtime — read-only from client)
    match /app_config/{docId} {
      // Authenticated users can read (app needs the API key)
      allow read: if request.auth != null;
      // Write only via Firebase Console or Admin SDK — never from client
      allow write: if false;
    }
    // 10. BATCH JOBS — created by client, processed by Cloud Function
    match /{jobCollection}/{jobId} {
      allow create: if request.auth != null && jobCollection in [
        'orientation_batch_jobs', 
        'full_intel_batch_jobs', 
        'property_data_batch_jobs',
        'narrative_batch_jobs',
        'asset_secure_batch_jobs'
      ];
      // Users can read their own job documents for progress polling
      allow read: if request.auth != null && (
        jobCollection in [
          'orientation_batch_jobs', 
          'full_intel_batch_jobs', 
          'property_data_batch_jobs',
          'narrative_batch_jobs',
          'asset_secure_batch_jobs'
        ]
        // Relaxing userId check for local dev/simplicity, but ideally:
        // && resource.data.userId == request.auth.uid
      );
      // Clients can only update status to 'cancelled' (Stop Run feature)
      // Actual progress updates happen via Admin SDK (bypassing rules)
      allow update: if request.auth != null && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                    request.resource.data.status == 'cancelled';
      allow delete: if false;
    }
  }
}
